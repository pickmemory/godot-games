[gd_scene load_steps=22 format=3]

; world 主场景 · 叠层对齐 architecture §8.2（P3-2 最小可走动子集 + 占位节点保留结构）。
; 实测确认（§13）：L3 用 Node2D.y_sort_enabled（YSort 独立节点在 Godot 4.7 已移除，K3）；
; Camera2D 用 position_smoothing_enabled/speed（K9）；地面用 TileMapLayer（K2）。
; P5-1（#13）：EncounterSpawner 接入 enemy_scene + Marker2D 刷新点；玩家移动/相机/地面保持不变。
; P5-2（#14）：Systems/CombatSystem 挂 C4 核心脚本 + player_combat/detection_globals 数据资源（combat §3.1/§3.4）。
; P5-5（#17）：Systems/RewriteCausalityEngine 挂 C1 核心脚本（改写/因果引擎·系统心脏，rewrite-causality.md）；
;   class_name Node（K10：非 Autoload），_ready 加 group "rewrite_engine"，挂 Systems/ 与 C2/C4 同范式。
; P5-6（#18）：Systems/RewriteFeedbackController 挂反馈调度（C1 锁结算信号 → STG/结算屏，按 feedback_tier 三档）；
;   L5_SystemCanvas/TimelineStage 挂历史线分叉演出（含 SettlementScreen，轨道 B 冷光唯一入口，art-bible §6/§0）；
;   RewritePanel/RewritePanelView 挂改写面板（Loop A 改写环操作台，ux-spec §6.3，与 SystemPanel 同层）。

[ext_resource type="Script" path="res://scripts/gameplay/world.gd" id="world_script"]
[ext_resource type="Script" path="res://scripts/foundation/test_ground.gd" id="ground_script"]
[ext_resource type="TileSet" path="res://assets/tilesets/tileset_dyn_threekingdoms_chibi.tres" id="test_tileset"]
[ext_resource type="PackedScene" path="res://scenes/actors/player.tscn" id="player_scene"]
[ext_resource type="Script" path="res://scripts/gameplay/encounter_spawner.gd" id="encounter_spawner_script"]
[ext_resource type="PackedScene" path="res://scenes/enemies/bandit.tscn" id="bandit_scene"]
[ext_resource type="Script" path="res://scripts/core/combat_system.gd" id="combat_system_script"]
[ext_resource type="Resource" path="res://data/combat/player_combat.tres" id="player_combat_data"]
[ext_resource type="Resource" path="res://data/globals/detection_globals.tres" id="detection_globals_data"]
[ext_resource type="Script" path="res://scripts/core/quest_system.gd" id="quest_system_script"]
[ext_resource type="Script" path="res://systems/rewrite/rewrite_causality_engine.gd" id="rewrite_engine_script"]
[ext_resource type="Script" path="res://systems/rewrite/rewrite_feedback_controller.gd" id="rewrite_feedback_script"]
[ext_resource type="PackedScene" path="res://ui/system_panel/system_panel.tscn" id="system_panel_scene"]
[ext_resource type="PackedScene" path="res://ui/rewrite_panel/rewrite_panel.tscn" id="rewrite_panel_scene"]
[ext_resource type="PackedScene" path="res://ui/rewrite_panel/timeline_stage.tscn" id="timeline_stage_scene"]
[ext_resource type="Script" path="res://scripts/juice/juice_controller.gd" id="juice_controller_script"]
[ext_resource type="Script" path="res://scripts/juice/screen_shake.gd" id="screen_shake_script"]
[ext_resource type="Shader" path="res://shaders/screen_damage_vignette.gdshader" id="damage_vignette_shader"]
[ext_resource type="Texture2D" path="res://assets/tilesets/prop_dyn_threekingdoms_chibi_camp_tent_shu.png" id="prop_tent"]
[ext_resource type="Texture2D" path="res://assets/tilesets/prop_dyn_threekingdoms_chibi_reed_wind_se.png" id="prop_reed"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_damage_vignette"]
shader = ExtResource("damage_vignette_shader")
shader_parameter/intensity = 0.0
shader_parameter/glow_color = Color(0.85, 0.12, 0.10, 1)
shader_parameter/edge_band = 0.32
shader_parameter/max_alpha = 0.55

[node name="World" type="Node2D"]
script = ExtResource("world_script")

[node name="L0_Parallax" type="Node2D" parent="."]

[node name="L1_Ground" type="TileMapLayer" parent="."]
tile_set = ExtResource("test_tileset")
script = ExtResource("ground_script")

[node name="L2_Props" type="TileMapLayer" parent="."]

[node name="CampTentShu" type="Sprite2D" parent="L2_Props"]
texture = ExtResource("prop_tent")
scale = Vector2(0.25, 0.25)
position = Vector2(-256, -192)

[node name="ReedSE_A" type="Sprite2D" parent="L2_Props"]
texture = ExtResource("prop_reed")
scale = Vector2(0.13, 0.13)
position = Vector2(128, 160)

[node name="ReedSE_B" type="Sprite2D" parent="L2_Props"]
texture = ExtResource("prop_reed")
scale = Vector2(0.13, 0.13)
position = Vector2(-160, 176)

[node name="L2b_Collision" type="NavigationRegion2D" parent="."]

[node name="L3_Characters" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Player" parent="L3_Characters" instance=ExtResource("player_scene")]

[node name="L4_Foreground" type="Node2D" parent="."]

[node name="Systems" type="Node" parent="."]

[node name="OpenWorldSystem" type="Node" parent="Systems"]

[node name="CombatSystem" type="Node" parent="Systems"]
script = ExtResource("combat_system_script")
player_combat = ExtResource("player_combat_data")
detection_globals = ExtResource("detection_globals_data")

[node name="QuestSystem" type="Node" parent="Systems"]
script = ExtResource("quest_system_script")
; chapter_data 故意置空（P5-9 校时 · issue #21）：world 作 Loop A「探索+战斗」前奏，N2 派发延迟到
; 改写节点场景（见 rewrite_node_director.gd 类注 + world.gd 类注），避免 world 一进入就 emit
; node_activated → RewritePanel 立即弹出，破坏「探索→战斗→改写」序列。C1/C2 仍留 world 供「继续」
; 读档 apply_pending_load 注入（§9.2）；chapter_data 置空不影响 deserialize（独立恢复账本/进度）。

[node name="RewriteCausalityEngine" type="Node" parent="Systems"]
script = ExtResource("rewrite_engine_script")
causal_links_path = "res://data/causal_links/causal_links_chibi.tres"

[node name="RewriteFeedbackController" type="Node" parent="Systems"]
script = ExtResource("rewrite_feedback_script")
timeline_stage_path = NodePath("../L5_SystemCanvas/TimelineStage")

[node name="EncounterSpawner" type="Node" parent="Systems"]
script = ExtResource("encounter_spawner_script")
enemy_scene = ExtResource("bandit_scene")
encounter_id = &"enc_bandit_ambush_01"
spawn_parent = NodePath("../../L3_Characters")
patrol_pace_px = 128.0

[node name="SpawnPointA" type="Marker2D" parent="Systems/EncounterSpawner"]
position = Vector2(180, 120)

[node name="SpawnPointB" type="Marker2D" parent="Systems/EncounterSpawner"]
position = Vector2(-220, 40)

[node name="SpawnPointC" type="Marker2D" parent="Systems/EncounterSpawner"]
position = Vector2(48, -200)

[node name="IntelPOIManager" type="Node" parent="Systems"]

[node name="JuiceController" type="Node" parent="Systems"]
; P6 juice 编排（art-director 最小视觉挂载 · 纯表现，不改玩法数值/逻辑，combat §6.5/§7.6）。
; 自动监听 EventBus.hp_changed（HP 下降→受击反馈：朱赤边缘光 + 微震屏）；reduce_motion 预留接设置菜单。
script = ExtResource("juice_controller_script")

[node name="L5_SystemCanvas" type="CanvasLayer" parent="."]

[node name="TimelineStage" parent="L5_SystemCanvas" instance=ExtResource("timeline_stage_scene")]

[node name="DamageVignette" type="ColorRect" parent="L5_SystemCanvas"]
; P6 受击朱赤边缘光（art-bible §2.1 点睛A / combat §7.6① 多通道之一）。全屏，不挡输入，intensity 默认 0。
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 0)
material = SubResource("ShaderMaterial_damage_vignette")

[node name="RewritePanel" type="CanvasLayer" parent="."]

[node name="SystemPanel" parent="RewritePanel" instance=ExtResource("system_panel_scene")]

[node name="RewritePanelView" parent="RewritePanel" instance=ExtResource("rewrite_panel_scene")]

[node name="X1_Narrator" type="Node" parent="."]

[node name="WindDirector" type="Node" parent="."]

[node name="HUDLayer" type="CanvasLayer" parent="."]

[node name="ObjectiveLabel" type="Label" parent="HUDLayer"]
unique_name_in_owner = true
offset_left = 24.0
offset_top = 20.0
offset_right = 1100.0
offset_bottom = 52.0
text = "目标"
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_constants/shadow_outline_size = 4
theme_override_font_sizes/font_size = 22

[node name="HintLabel" type="Label" parent="HUDLayer"]
unique_name_in_owner = true
offset_left = 24.0
offset_top = 56.0
offset_right = 1100.0
offset_bottom = 82.0
text = ""
theme_override_colors/font_color = Color(0.55, 0.78, 0.95, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_constants/shadow_outline_size = 4
theme_override_font_sizes/font_size = 16

[node name="Camera2D" type="Camera2D" parent="."]
position_smoothing_enabled = true
position_smoothing_speed = 6.0
zoom = Vector2(1, 1)

[node name="ScreenShake" type="Node" parent="Camera2D"]
; P6 震屏（trauma 模型，写 Camera2D.offset，与 world.gd 的 global_position 正交；art-bible §3.1 节制）。
script = ExtResource("screen_shake_script")
