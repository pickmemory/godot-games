[ext_resource type="Script" path="res://scripts/core/combat_system.gd" id="5_combat"]
[ext_resource type="Resource" path="res://data/combat/player_combat.tres" id="6_player_combat"]
[ext_resource type="Resource" path="res://data/globals/detection_globals.tres" id="7_detection"]
[ext_resource type="Script" path="res://scripts/core/quest_system.gd" id="8_quest"]
[ext_resource type="Script" path="res://systems/rewrite/rewrite_causality_engine.gd" id="9_engine"]
[ext_resource type="Script" path="res://systems/rewrite/rewrite_feedback_controller.gd" id="10_feedback"]
[ext_resource type="Script" path="res://scripts/gameplay/encounter_spawner.gd" id="11_spawner"]
