[node name="CollisionShape2D" type="CollisionShape2D" parent="Zones/AltarZone"]
shape = SubResource("altar_shape")

[node name="Systems" type="Node" parent="."]

[node name="CombatSystem" type="Node" parent="Systems"]
script = ExtResource("5_combat")
player_combat = ExtResource("6_player_combat")
detection_globals = ExtResource("7_detection")

[node name="QuestSystem" type="Node" parent="Systems"]
script = ExtResource("8_quest")
; chapter_data 故意置空（延迟派发）：由 RewriteNodeDirector 在术士触发时赋值 + enter_chapter()。
; 详见 rewrite_node_director.gd 类注（mainline §2.5 / 信号生命周期）。

[node name="RewriteCausalityEngine" type="Node" parent="Systems"]
script = ExtResource("9_engine")
causal_links_path = "res://data/causal_links/causal_links_chibi.tres"

[node name="RewriteFeedbackController" type="Node" parent="Systems"]
script = ExtResource("10_feedback")
; timeline_stage_path 用脚本默认值 ../../L5_SystemCanvas/TimelineStage（本布局正确）；TimelineStage 亦登记 group timeline_stage 兜底。

[node name="EncounterSpawner" type="Node" parent="Systems"]
