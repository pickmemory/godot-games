[ext_resource type="PackedScene" path="res://ui/rewrite_panel/timeline_stage.tscn" id="13_timeline"]
[ext_resource type="PackedScene" path="res://ui/rewrite_panel/rewrite_panel.tscn" id="14_panel"]
[ext_resource type="Resource" path="res://data/scenes/rewrite_node_chibi/east_wind_flow.tres" id="15_flow"]
[ext_resource type="Resource" path="res://data/quests/chapters/ch_chibi_war.tres" id="16_chapter"]
[ext_resource type="Script" path="res://scripts/gameplay/player_hud.gd" id="17_hud"]

[sub_resource type="CircleShape2D" id="shaman_shape"]
radius = 96.0

[sub_resource type="CircleShape2D" id="altar_shape"]
radius = 96.0

[node name="RewriteNodeChibi" type="Node2D"]
script = ExtResource("1_director")
flow_data = ExtResource("15_flow")
chapter_data = ExtResource("16_chapter")
debug_log = true

[node name="L1_Ground" type="TileMapLayer" parent="."]
tile_set = ExtResource("3_tileset")
script = ExtResource("2_ground")

[node name="L3_Characters" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Player" parent="L3_Characters" instance=ExtResource("4_player")]

[node name="Zones" type="Node2D" parent="."]

[node name="ClueZones" type="Node2D" parent="Zones"]

[node name="ShamanZone" type="Area2D" parent="Zones"]
position = Vector2(0, 0)

[node name="CollisionShape2D" type="CollisionShape2D" parent="Zones/ShamanZone"]
shape = SubResource("shaman_shape")

[node name="AltarZone" type="Area2D" parent="Zones"]
