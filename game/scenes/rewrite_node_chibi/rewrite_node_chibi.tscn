[gd_scene load_steps=20 format=3]

; 改写节点场景 · 赤壁·借东风（issue #19 · Loop A 端到端整合 · 复用 P5-1..P5-6 全部系统）。
; 可独立运行：$GODOT_BIN --path game res://scenes/rewrite_node_chibi/rewrite_node_chibi.tscn
; 可被主世界加载：自包含 PackedScene，future world loader 可 instance（架构 §8.2 叠层）。
;
; 节点编排（RewriteNodeDirector）串联 Loop A：探索(TileMap)→收集(3 线索 POI)→门条件(≥2)→术士(授术+派发)
; →抉择(RewritePanel #18)→引擎结算(RewriteCausalityEngine #17)→旁白+演出(TimelineStage #18)→完成(回写 #16)。
;
; ⚠️ 派发延迟：QuestSystem.chapter_data **置空**（_ready 不自动派发），由导演在术士触发时
;   quest.chapter_data=...; quest.enter_chapter() 显式派发（见 rewrite_node_director.gd 类注）。
; ⚠️ 复用而非重写：敌人/战斗/改写引擎/RewritePanel/反馈控制器全部走既有脚本与信号契约，本场景只做编排。

[ext_resource type="Script" path="res://scenes/rewrite_node_chibi/rewrite_node_director.gd" id="1_director"]
[ext_resource type="Script" path="res://scripts/foundation/test_ground.gd" id="2_ground"]
