[gd_scene load_steps=3 format=3]

; SystemPanel · 系统面板 UI（玩法层 G7 · architecture §8.3 RewritePanel CanvasLayer 子 · ux-spec §6）。
; 挂 world.tscn RewritePanel（CanvasLayer，覆于 L5_SystemCanvas/HUD 之上）；默认关闭，ui_menu 呼出。
; 节点引用用 scene-unique 名（%Name，unique_name_in_owner=true），与容器嵌套深度解耦。
; 本 issue（P5-3）：呼出/关闭 + 四项核心只读显示（CP余额/章节进度/当前任务/历史偏差Δ）；
; 技能树/兑换/情报 Tab 显占位（TODO(p-followup)）。冷光材质（art-bible §6.1）暂用纯色 + 默认主题占位。

[ext_resource type="Script" path="res://ui/system_panel/system_panel.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/panel/ui_strings.tres" id="2_strings"]

[node name="SystemPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_script")
ui_strings = ExtResource("2_strings")
initial_tab = 4

[node name="BgRect" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.02, 0.05, 0.1, 0.55)

[node name="CenterWrap" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="PanelBg" type="PanelContainer" parent="CenterWrap"]
custom_minimum_size = Vector2(720, 440)

[node name="Margin" type="MarginContainer" parent="CenterWrap/PanelBg"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="CenterWrap/PanelBg/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="CenterWrap/PanelBg/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_font_sizes/font_size = 22
text = "改写者系统 · 观测台"

[node name="HeaderRow" type="HBoxContainer" parent="CenterWrap/PanelBg/Margin/VBox"]
