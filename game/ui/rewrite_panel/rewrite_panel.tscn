[gd_scene load_steps=3 format=3]

; RewritePanelView · 改写面板（Loop A「改写」环操作台 · ux-spec §6.3 / rewrite-causality §6.3）。
; 挂 world.tscn RewritePanel(CanvasLayer) 子（与 SystemPanel 同层，architecture §8.3）；默认关闭。
; 节点引用用 scene-unique 名（%Name）。蓝图/动词列表由脚本动态填充（数据驱动）。
; 冷光材质（art-bible §6.1）纯色 + 默认主题占位（半透明网格墨蓝底 + 青蓝硬边 + 数据白等宽）。
[ext_resource type="Script" path="res://ui/rewrite_panel/rewrite_panel.gd" id="1_script"]
[ext_resource type="Resource" path="res://systems/rewrite/rewrite_narration_chibi.tres" id="2_narration"]

[node name="RewritePanelView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_script")
narration_data = ExtResource("2_narration")

[node name="BgRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.01, 0.03, 0.07, 0.45)

[node name="CenterWrap" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="PanelBg" type="PanelContainer" parent="CenterWrap"]
custom_minimum_size = Vector2(900, 640)

