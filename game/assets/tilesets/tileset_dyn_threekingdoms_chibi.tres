; 赤壁 TileSet（mmx 真实资产 · 接线 P5-10 §8.4）
; 4 个地面源（dry/wetland/water/shore），每张 512×512 无缝图（4 折镜像无缝）作单 tile，
; texture_region_size=512 + tile_size=64 → 引擎缩放渲染，整图无缝拼贴。
; 源 id 顺序对齐 test_ground.gd 常量 SRC_DRY=0 / SRC_WETLAND=1 / SRC_WATER=2 / SRC_SHORE=3。
[gd_resource type="TileSet" load_steps=9 format=3]

[ext_resource type="Texture2D" path="res://assets/tilesets/tile_dyn_threekingdoms_chibi_ground_dry.png" id="tex_dry"]
[ext_resource type="Texture2D" path="res://assets/tilesets/tile_dyn_threekingdoms_chibi_ground_wetland.png" id="tex_wetland"]
[ext_resource type="Texture2D" path="res://assets/tilesets/tile_dyn_threekingdoms_chibi_water_river.png" id="tex_water"]
[ext_resource type="Texture2D" path="res://assets/tilesets/tile_dyn_threekingdoms_chibi_shore_edge.png" id="tex_shore"]

[sub_resource type="TileSetAtlasSource" id="src_dry"]
texture = ExtResource("tex_dry")
texture_region_size = Vector2i(512, 512)
0:0/0 = 0

[sub_resource type="TileSetAtlasSource" id="src_wetland"]
texture = ExtResource("tex_wetland")
texture_region_size = Vector2i(512, 512)
0:0/0 = 0

[sub_resource type="TileSetAtlasSource" id="src_water"]
texture = ExtResource("tex_water")
texture_region_size = Vector2i(512, 512)
0:0/0 = 0

[sub_resource type="TileSetAtlasSource" id="src_shore"]
texture = ExtResource("tex_shore")
texture_region_size = Vector2i(512, 512)
0:0/0 = 0

[resource]
tile_size = Vector2i(256, 256)
sources/0 = SubResource("src_dry")
sources/1 = SubResource("src_wetland")
sources/2 = SubResource("src_water")
sources/3 = SubResource("src_shore")
