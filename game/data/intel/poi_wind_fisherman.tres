; 情报采集点 · 江岸渔夫（数据驱动 · S5 · open-world §3.2 / §2.2）。
; poi_id: poi_wind_fisherman —— N2 借东风「风向」线索（NPC 即采集点的另一种形式，open-world §3.3 注）。
; 玩家靠近渔夫按 E 对话采集 → 产出风向口述情报。命名空间 dyn_threekingdoms_chibi。
[gd_resource type="Resource" script_class="IntelPOIData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/intel_poi_data.gd" id="1_main"]

[resource]
script = ExtResource("1_main")
poi_id = &"poi_wind_fisherman"
dynasty = &"dyn_threekingdoms_chibi"
display_name = "江岸渔夫"
position = Vector2(448, -96)
interact_radius_px = 80.0
intel_kind = &"wind_intel"
intel_raw = 0.25
relates_to_node = &"n2_east_wind"
intel_entry_id = &"intel_wind_fisherman_talk"
lore_text = "老渔夫摇头：「这两日仍是西北风，东南风要等借。」"
system_voice_on_collect = "情报已收录·渔夫口述·近日风向。"
