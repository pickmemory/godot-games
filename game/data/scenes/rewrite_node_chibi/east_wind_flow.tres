; 改写节点场景编排配置 · 赤壁·借东风（数据驱动 · issue #19 · RewriteNodeDirector 读取）。
; flow_id: east_wind —— 串联 N2 借东风的端到端 Loop A 编排参数。
;
; 线索集：3 个 wind_intel POI（各 intel_raw 0.25 → 全收集 intel_cov=0.75）。
; 任务门：required_clue_count=2（术士允许触发改写；issue §2.3）。
;   · 2 条线索 → intel_cov=0.5 < 0.6 → bp_player_self_wind 仍锁定（仅 bp_baseline_keep 可选）；
;   · 3 条线索 → intel_cov=0.75 ≥ 0.6 → bp_player_self_wind 解锁（探索→精确蓝图回路，rewrite §2.4）。
;   此双门设计同时演示「线索数门（术士）」与「intel_cov 门（蓝图）」，奖励充分探索。
; 术士授术：ability_system_magic_wind（rewrite_proxy；S3 未落地，导演代理 ability_unlocked）。
; 七星坛交互：verb_smash_altar（S5 交互 → verb_executed → S1 改 v_altar=smashed，§5.3 DAG）。
;
; ⚠️ 引用不重定义：node_id/chapter_id/verb_id 仅引用 S1/S2 既有数据，本资源不含 vars/blueprints 等。
[gd_resource type="Resource" script_class="RewriteNodeFlowData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_node_flow_data.gd" id="1_main"]
[ext_resource type="Resource" path="res://data/intel/poi_wind_reed_observatory.tres" id="2_reed"]
[ext_resource type="Resource" path="res://data/intel/poi_wind_fisherman.tres" id="3_fisher"]
[ext_resource type="Resource" path="res://data/intel/poi_sky_old_man.tres" id="4_oldman"]

[resource]
script = ExtResource("1_main")
flow_id = &"east_wind"
dynasty = &"dyn_threekingdoms_chibi"
node_id = &"n2_east_wind"
chapter_id = &"ch_chibi_war"
clue_pois = [ExtResource("2_reed"), ExtResource("3_fisher"), ExtResource("4_oldman")]
required_clue_count = 2
granted_ability_id = &"ability_system_magic_wind"
altar_verb_id = &"verb_smash_altar"
altar_scene_id = &"scene_altar"
player_start_position = Vector2(0, 320)
shaman_position = Vector2(0, 0)
shaman_interact_radius_px = 96.0
altar_position = Vector2(0, -480)
altar_interact_radius_px = 96.0
objective_explore = "探索赤壁村落，收集气象线索（靠近光点按 E 交互）。沿途或遇山贼。"
objective_rewrite = "改写节点已激活：在改写面板声明意图（选蓝图）；可至七星坛施术（skill_1）/破坏（E），再确认改写。"
objective_complete = "节点已确认。历史偏差已记录，因果已传递——Loop A 闭环。"
hint_clues_needed = "术士：线索不足，无法开启改写。继续探索（需 ≥{n} 条）。"
