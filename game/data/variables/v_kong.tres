; 关键变量 v_kong · 诸葛亮状态（数据驱动 · S1 · rewrite-causality §3.1）。
; var_id: v_kong —— N2 节点变量（权重 w=0.2）。玩家可截杀诸葛亮（verb_block_kongming，经战斗击杀）。
; 取值：alive（baseline，史实诸葛亮存活 → 借风成功，d=0）/ dead（被截杀，d=1.0）。
[gd_resource type="Resource" script_class="RewriteVariableData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_variable_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_enum_value_data.gd" id="2_entry"]

[sub_resource type="Resource" id="v_alive" script_class="RewriteEnumValueData"]
script = ExtResource("2_entry")
key = &"alive"
display = "存活"
deviation = 0.0
world_visual_token = &"prop_dyn_threekingdoms_chibi_npc_kongming_alive"

[sub_resource type="Resource" id="v_dead" script_class="RewriteEnumValueData"]
script = ExtResource("2_entry")
key = &"dead"
display = "被截杀"
deviation = 1.0
world_visual_token = &"prop_dyn_threekingdoms_chibi_npc_kongming_dead"

[resource]
script = ExtResource("1_main")
var_id = &"v_kong"
display_name = "诸葛亮状态"
dynasty = &"dyn_threekingdoms_chibi"
type = 0
entries = [SubResource("v_alive"), SubResource("v_dead")]
value_min = 0.0
value_max = 1.0
value_step = 1.0
baseline_numeric = 0.0
baseline = &"alive"
