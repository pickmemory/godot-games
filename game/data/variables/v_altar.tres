; 关键变量 v_altar · 七星坛状态（数据驱动 · S1 · rewrite-causality §3.1）。
; var_id: v_altar —— N2 节点变量（权重 w=0.2）。玩家可破坏坛致借风失败（verb_smash_altar）。
; 取值：intact（baseline，史实坛完好 → 借风成功，d=0）/ smashed（坛毁，d=1.0）。
[gd_resource type="Resource" script_class="RewriteVariableData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_variable_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_enum_value_data.gd" id="2_entry"]

[sub_resource type="Resource" id="v_intact" script_class="RewriteEnumValueData"]
script = ExtResource("2_entry")
key = &"intact"
display = "完好"
deviation = 0.0
world_visual_token = &"prop_dyn_threekingdoms_chibi_altar_intact"

[sub_resource type="Resource" id="v_smashed" script_class="RewriteEnumValueData"]
script = ExtResource("2_entry")
key = &"smashed"
display = "被毁"
deviation = 1.0
world_visual_token = &"prop_dyn_threekingdoms_chibi_altar_smashed"

[resource]
script = ExtResource("1_main")
var_id = &"v_altar"
display_name = "七星坛状态"
dynasty = &"dyn_threekingdoms_chibi"
type = 0
entries = [SubResource("v_intact"), SubResource("v_smashed")]
value_min = 0.0
value_max = 1.0
value_step = 1.0
baseline_numeric = 0.0
baseline = &"intact"
