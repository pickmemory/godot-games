; 改写动词 · 玩家自借东风（数据驱动 · S1 · rewrite-causality §3.5 / §1.2 系统侧介入类）。
; verb_id: verb_self_borrow_wind —— N2 节点分支 C（玩家自借东风，game-concept §6.2 分支 C）。
; 物理执行：玩家释放 ability_system_magic_wind（rewrite_proxy，combat §2.6/§3.2 示例二）→
;   C4 发 verb_executed(verb_self_borrow_wind, scene_altar, true) → C1 据本表 effect.set 改 v_wind=southeast（§5.3 DAG）。
; requires_ability: ability_system_magic_wind（S3 解锁 → C4 释放校验，combat §2.6；S3 未落地时 C1 不校验 ability，归 S4）。
; special_flags: triggers_self_replacement_voice（系统旁白「功劳归于玩家」，game-concept §6.2 分支 C）。
[gd_resource type="Resource" script_class="RewriteVerbData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_verb_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/verb_effect_set.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_wind" script_class="VerbEffectSet"]
script = ExtResource("2_eff")
var_id = &"v_wind"
value = "southeast"

[resource]
script = ExtResource("1_main")
verb_id = &"verb_self_borrow_wind"
dynasty = &"dyn_threekingdoms_chibi"
display_name = "自借东风（系统术法）"
cost_base = 40
effect_sets = [SubResource("eff_wind")]
effect_flags = PackedStringArray("system_side", "triggers_self_replacement_voice")
requires_ability = &"ability_system_magic_wind"
requires_scene = &"scene_altar"
