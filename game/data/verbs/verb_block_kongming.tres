; 改写动词 · 截杀诸葛亮（数据驱动 · S1 · rewrite-causality §3.5 / §1.2 直接改值类）。
; verb_id: verb_block_kongming —— N2 节点可用动词。物理执行归 S4 战斗（击杀诸葛亮），成功后发
; verb_executed(verb_block_kongming, target=enemy_kongming, true) → C1 据本表 effect.set 改两个 v_i（§5.3 DAG）：
;   - v_kong=dead（截杀达成）
;   - v_wind=none（无人借风 → 借风失败；连带效应，game-concept §6.2 分支 B）
; 这样单动词即达 Δ=80（v_wind none d=1.0·w0.6 + v_kong dead d=1.0·w0.2 = 0.8·100）→ critical 档，
; 供 P5-7 串联与 §4.5 世界线震荡测试复用。
[gd_resource type="Resource" script_class="RewriteVerbData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/rewrite_verb_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/verb_effect_set.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_kong" script_class="VerbEffectSet"]
script = ExtResource("2_eff")
var_id = &"v_kong"
value = "dead"

[sub_resource type="Resource" id="eff_wind" script_class="VerbEffectSet"]
script = ExtResource("2_eff")
var_id = &"v_wind"
value = "none"

[resource]
script = ExtResource("1_main")
verb_id = &"verb_block_kongming"
dynasty = &"dyn_threekingdoms_chibi"
display_name = "截杀诸葛亮"
cost_base = 35
effect_sets = [SubResource("eff_kong"), SubResource("eff_wind")]
effect_flags = PackedStringArray()
requires_ability = &""
requires_scene = &"scene_altar"
