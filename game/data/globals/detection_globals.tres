; 感知/噪声全局配置（数据驱动 · S4 拥有全局感知规则 · combat §3.4 / architecture §6.2）。
; ⚠️ 落点 data/globals/（architecture §6.2 表拍板），非 combat.md §3.4 字面的 data/combat/——
; 按 issue「以 architecture 为准」落位，见 issue comment 说明。与 player_movement_globals.tres 同处 globals/。
; alert_mult 数值 1.0/1.0/1.2/1.5 为首版倾向 [待审批]（combat §4.5/§7.7①，待与 S1 联合确认应用方）。
[gd_resource type="Resource" script_class="DetectionGlobalsData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/detection_globals_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/alert_level_data.gd" id="2_alert"]

[sub_resource type="Resource" id="alert0" script_class="AlertLevelData"]
script = ExtResource("2_alert")
level = 0
name = "unaware"
alert_mult = 1.0

[sub_resource type="Resource" id="alert1" script_class="AlertLevelData"]
script = ExtResource("2_alert")
level = 1
name = "suspicious"
alert_mult = 1.0

[sub_resource type="Resource" id="alert2" script_class="AlertLevelData"]
script = ExtResource("2_alert")
level = 2
name = "detected"
alert_mult = 1.2

[sub_resource type="Resource" id="alert3" script_class="AlertLevelData"]
script = ExtResource("2_alert")
level = 3
name = "engaged"
alert_mult = 1.5

[resource]
script = ExtResource("1_main")
alert_levels = [SubResource("alert0"), SubResource("alert1"), SubResource("alert2"), SubResource("alert3")]
noise_sprint = 160.0
noise_walk = 64.0
noise_crouch = 0.0
noise_basic_attack = 96.0
noise_system_magic = 128.0
on_wetland_mult = 1.5
reed_conceal_sight_mult = 0.3
smoke_block_sight = true
