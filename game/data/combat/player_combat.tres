; 玩家战斗配置（数据驱动 · S4 战斗执行数值 · combat §3.1 / architecture §6.2）。
; entity_id: char_player_traveler —— 穿越者玩家（art-bible §9.2 命名一致）。
; 数值照搬 combat §3.1 首版倾向值；普攻 3 段连段 mult 1.0/1.0/1.4（§2.3），第 3 段带击退。
; 闪避/硬直 mvp_enabled=false（范围决策：GDD 基线优先于 roadmap「无敌帧」字面措辞，见 issue comment）。
; ⚠️ P5-2 占位调参，非最终平衡；精确值待 P6 Playtest（严守真）。
[gd_resource type="Resource" script_class="PlayerCombatData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/player_combat_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/basic_attack_stage_data.gd" id="2_stage"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/player_dodge_data.gd" id="3_dodge"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/player_stagger_data.gd" id="4_stagger"]

[sub_resource type="Resource" id="stage1" script_class="BasicAttackStageData"]
script = ExtResource("2_stage")
mult = 1.0
stagger_value = 6.0
windup = 0.08
active = 0.10
recover = 0.12
cancel_from = 0.60
knockback = 0.0

[sub_resource type="Resource" id="stage2" script_class="BasicAttackStageData"]
script = ExtResource("2_stage")
mult = 1.0
stagger_value = 6.0
windup = 0.08
active = 0.10
recover = 0.12
cancel_from = 0.60
knockback = 0.0

[sub_resource type="Resource" id="stage3" script_class="BasicAttackStageData"]
script = ExtResource("2_stage")
mult = 1.4
stagger_value = 12.0
windup = 0.12
active = 0.14
recover = 0.20
cancel_from = 0.60
knockback = 24.0

[sub_resource type="Resource" id="dodge" script_class="PlayerDodgeData"]
script = ExtResource("3_dodge")
bf_cost = 18
i_frames = 0.35
dodge_dist_px = 96.0
recover = 0.15
mvp_enabled = false

[sub_resource type="Resource" id="stagger" script_class="PlayerStaggerData"]
script = ExtResource("4_stagger")
stagger_threshold = 30.0
stagger_dur = 0.5
regen_stagger = 10.0
mvp_enabled = false

[resource]
script = ExtResource("1_main")
entity_id = &"char_player_traveler"
dynasty = &"dyn_threekingdoms_chibi"
hp_max = 100
hp_regen_ooc = 4.0
bf_max = 100
regen_bf_passive = 6.0
regen_bf_on_hit = 3
atk_base = 18
def_base = 5
crit_chance = 0.0
crit_mult = 1.5
basic_attack_stages = [SubResource("stage1"), SubResource("stage2"), SubResource("stage3")]
hitbox_shape = "arc_front"
hitbox_range_px = 56.0
hitbox_hits_per_swing = 1
dodge = SubResource("dodge")
stagger = SubResource("stagger")
respawn_rule = "reload_encounter"
cp_penalty = 0
node_progress_loss = false
