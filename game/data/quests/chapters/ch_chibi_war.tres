; 章节表 · 赤壁之战（数据驱动 · S2 章节编排 · mainline-quest §3.1 / architecture §6.2）。
; chapter_id: ch_chibi_war —— 垂直切片唯一章节（dyn_threekingdoms_chibi 命名空间，art-bible §9.1）。
; ordered_nodes 含 N1/N2/N3 全集（权重 Σ=1.0，§4.3 归一化）；mvp_subset 只激活 N2（game-concept §7.1）。
; 替代节点/章末收敛为目标态预留字段（game-concept §9④ / mainline §5.4），MVP 不激活。
; ⚠️ 权重为首版倾向值（n1=0.3/n2=0.4/n3=0.3），待 P5/P6 Playtest 校准。
[gd_resource type="Resource" script_class="ChapterData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/chapter_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/chapter_node_entry_data.gd" id="2_entry"]

[sub_resource type="Resource" id="entry_n1" script_class="ChapterNodeEntryData"]
script = ExtResource("2_entry")
node_id = &"n1_chain_scheme"
weight = 0.3

[sub_resource type="Resource" id="entry_n2" script_class="ChapterNodeEntryData"]
script = ExtResource("2_entry")
node_id = &"n2_east_wind"
weight = 0.4

[sub_resource type="Resource" id="entry_n3" script_class="ChapterNodeEntryData"]
script = ExtResource("2_entry")
node_id = &"n3_huarong"
weight = 0.3

[resource]
script = ExtResource("1_main")
chapter_id = &"ch_chibi_war"
dynasty = &"dyn_threekingdoms_chibi"
display_title = "赤壁之战"
ordered_nodes = [SubResource("entry_n1"), SubResource("entry_n2"), SubResource("entry_n3")]
mvp_subset = [&"n2_east_wind"]
alternative_nodes = []
convergence = &"ch_end_chibi"
