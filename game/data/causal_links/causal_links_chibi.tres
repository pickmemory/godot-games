; 因果链聚合表 · 赤壁（数据驱动 · S1 唯一所有者 · rewrite-causality §3.4 / §2.5 / architecture §6.2）。
; 朝代命名空间：dyn_threekingdoms_chibi。3 节点最小链（N1→N2→N3），存在性依赖最多一层（§5.2 范围红线）。
;
; 本表含 N2→N3 两条链（MVP 最小子集，对齐 rewrite-causality §3.4 示例）：
;   1) link_wind_to_n3（VALUE）：N2 v_wind 解析值 → N3 输入「fire_power」。transform 把风向映射为火攻威力。
;   2) link_fire_power_to_n3_existence（EXISTENCE）：N3 仅当 fire_power==high 才存在（game-concept §6.3）。
;      source_input=fire_power（消费上面 value 链产出的输入，§3.4 注：source 可依赖输入而非原始 v_i）。
;      condition 评估归 S1（§7.1 两段式），派发/消失决策归 S2（C2 读 _EXISTENCE_SATISFYING_TOKENS）。
; N1→N2 链（连舟→火攻难度）为目标态（MVP 仅 N2 激活），本表暂不含；P5-7 串联 N1 时扩展。
[gd_resource type="Resource" script_class="CausalLinksData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/causal_links_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/causal_link_data.gd" id="2_link"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/causal_transform_entry.gd" id="3_xform"]

[sub_resource type="Resource" id="x_se" script_class="CausalTransformEntry"]
script = ExtResource("3_xform")
from_value = "southeast"
to_value = "high"

[sub_resource type="Resource" id="x_none" script_class="CausalTransformEntry"]
script = ExtResource("3_xform")
from_value = "none"
to_value = "none"

[sub_resource type="Resource" id="x_nw" script_class="CausalTransformEntry"]
script = ExtResource("3_xform")
from_value = "northwest"
to_value = "reverse"

[sub_resource type="Resource" id="link_wind" script_class="CausalLinkData"]
script = ExtResource("2_link")
link_id = &"link_wind_to_n3"
dynasty = &"dyn_threekingdoms_chibi"
type = 0
source_node = &"n2_east_wind"
source_var = &"v_wind"
source_input = &""
target_node = &"n3_huarong"
target_input = &"fire_power"
target_field = &""
transform_entries = [SubResource("x_se"), SubResource("x_none"), SubResource("x_nw")]
transform_fallback = "none"
condition = ""
on_false = &""

[sub_resource type="Resource" id="link_exist" script_class="CausalLinkData"]
script = ExtResource("2_link")
link_id = &"link_fire_power_to_n3_existence"
dynasty = &"dyn_threekingdoms_chibi"
type = 1
source_node = &"n2_east_wind"
source_var = &""
source_input = &"fire_power"
target_node = &"n3_huarong"
target_input = &""
target_field = &""
transform_entries = []
transform_fallback = ""
condition = "fire_power==high"
on_false = &"spawn_alternative"

[resource]
script = ExtResource("1_main")
dynasty = &"dyn_threekingdoms_chibi"
links = [SubResource("link_wind"), SubResource("link_exist")]
