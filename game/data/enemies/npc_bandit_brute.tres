; 敌人定义 · 山贼原型（数据驱动 · S4 战斗执行数值 · combat §3.3 / architecture §6.2）。
; enemy_id: npc_bandit_brute —— 赤壁民间山贼（faction=folk，非魏蜀吴正规军）。
; 数值照搬 combat §3.3 字段命名；感知/攻击为内联子资源（EnemyDetectionData / EnemyAIData / EnemyAttackData）。
; 巡逻路线（patrol_route）不落此文件：归 S5 遭遇布置（open-world §3.3），由遭遇生成器运行时注入。
; ⚠️ P5-1 占位调参，非最终平衡；精确值待 P5-2 联战 + P6 Playtest。
[gd_resource type="Resource" script_class="EnemyData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/foundation/data_resources/enemy_data.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/enemy_detection_data.gd" id="2_det"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/enemy_ai_data.gd" id="3_ai"]
[ext_resource type="Script" path="res://scripts/foundation/data_resources/enemy_attack_data.gd" id="4_atk"]

[sub_resource type="Resource" id="sub_det" script_class="EnemyDetectionData"]
script = ExtResource("2_det")
view_cone_half_deg = 40.0
view_radius_px = 320.0
hearing_radius_px = 144.0
sight_gain_rate = 1.5
hear_gain_rate = 3.0
lose_target_time = 5.0
alert_decay = 3.0

[sub_resource type="Resource" id="sub_atk" script_class="EnemyAttackData"]
script = ExtResource("4_atk")
id = &"atk_bandit_cleave"
windup = 0.55
active = 0.12
recover = 0.35
mult = 1.3
range_px = 56.0
knockback_px = 28.0
interruptible = true
cooldown = 2.0

[sub_resource type="Resource" id="sub_ai" script_class="EnemyAIData"]
script = ExtResource("3_ai")
fsm_preset = "patrol_chase_attack"
attacks = [SubResource("sub_atk")]
chase_speed_mult = 1.0
patrol_speed_mult = 0.55

[resource]
script = ExtResource("1_main")
enemy_id = &"npc_bandit_chibi"
display_name = "山贼头目"
dynasty = &"dyn_threekingdoms_chibi"
faction = &"folk"
hp_max = 130
atk_base = 20
def_base = 2
move_speed_px = 102.0
resist_physical = 0.0
resist_system_arcane = 0.1
resist_fire = 0.1
stagger_threshold = 16.0
hurt_dur = 0.25
knockback_mass = 1.8
detection = SubResource("sub_det")
ai = SubResource("sub_ai")
sprite_ref = &"npc_bandit_chibi"
anim_ref = &"anim_npc_bandit_chibi"
