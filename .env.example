# ============================================================
# 本地密钥配置模板 —— 复制为 .env 并填入真实 Key（.env 已 gitignore，不会提交）
# ============================================================
#
# MiniMax Token Plan 订阅 Key（多模态资产生成：图片/音乐/语音/视频）
# 获取：你的 MiniMax 订阅后台 / https://platform.minimaxi.com
# 用途：本地 mmx CLI 鉴权（tools/mmx-setup.cmd 会读取本文件并 mmx auth login 持久化到 ~/.mmx）
#
MINIMAX_API_KEY=
MINIMAX_REGION=cn
